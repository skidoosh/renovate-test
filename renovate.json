{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeDisabled",  
    ":disableMajorUpdates", 
    ":disableRateLimiting",
    ":semanticCommitTypeAll(chore)",
    ":rebaseStalePrs"
  ],
  "minimumReleaseAge": "72 hours",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["terraform", "terraform-version"],
      "groupName": "terraform dependencies",
      "matchUpdateTypes": ["digest", "patch", "minor"]
    },
    {
      "matchManagers": ["dockerfile", "pyenv", "pep621"],
      "groupName": "application dependencies",
      "matchUpdateTypes": ["digest", "patch"]
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "fasapi dependencies",
      "matchUpdateTypes": ["digest", "patch"],
      "matchPackageNames": ["fastapi"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
