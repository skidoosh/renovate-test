{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeDisabled",  
    ":disableMajorUpdates", 
    ":disableRateLimiting",
    ":semanticCommitTypeAll(chore)",
    ":rebaseStalePrs"
  ],
  "minimumReleaseAge": "72 hours",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["terraform", "terraform-version"],
      "groupName": "infrastructure as code updates",
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "separateMinorPatch": false
    },
    {
      "matchManagers": ["dockerfile", "pyenv"],
      "groupName": "environment updates",
      "matchUpdateTypes": ["digest", "patch"]
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "application updates",
      "matchUpdateTypes": ["digest", "minor", "patch"]
    }
  ]
}
