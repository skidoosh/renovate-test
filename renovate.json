{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",  
    ":disableMajorUpdates", 
    ":disableRateLimiting",
    ":rebaseStalePrs"
  ],
  "abandonmentThreshold": "1 year",
  "labels": [
    "renovate"
  ],
  "minimumReleaseAge": "72 hours",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["terraform", "terraform-version", "dockerfile", "pyenv", "pep621"],
      "groupName": "all dependencies",
      "matchUpdateTypes": ["digest", "lockFileMaintenance", "patch", "minor"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine(?<build>\\d+)\\.(?<revision>\\d+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchManagers": ["pyenv"],
      "minimumReleaseAge": "1 day"
    }
  ]
}
