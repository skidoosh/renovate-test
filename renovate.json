{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "separateMinorPatch": true,
  "commitHourlyLimit": 0,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["patch"],
      "enabled": true,
      "groupName": "All patch level updates",
      "groupSlug": "all-patch-level-updates"
    }
  ]
}
