{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeDisabled",  
    ":disableMajorUpdates", 
    ":disableRateLimiting",
    ":semanticCommitTypeAll(chore)",
    ":separatePatchRelease",
    ":rebaseStalePrs"
  ],
  "minimumReleaseAge": "7 days"
}
