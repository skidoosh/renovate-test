{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "major": {"enabled": false},
  "minor": {"enabled": false},
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}