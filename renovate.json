{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",  
    ":disableMajorUpdates", 
    ":disableRateLimiting",
    ":rebaseStalePrs",
    "abandonments:recommended"
  ],
  "labels": [
    "renovate"
  ],
  "minimumReleaseAge": "72 hours",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["terraform", "terraform-version", "dockerfile", "pyenv", "pep621"],
      "groupName": "all dependencies",
      "matchUpdateTypes": ["digest", "lockFileMaintenance", "patch", "minor"]
    }
  ]
}
